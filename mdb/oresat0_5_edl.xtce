    <MetaCommandSet>
      <MetaCommand name="tx_control" shortDescription="enable / disable tx">
        <ArgumentList>
          <Argument name="enable" argumentTypeRef="bool_type" />
        </ArgumentList>
        <CommandContainer name="tx_control_request">
          <EntryList>
            <FixedValueEntry binaryValue="00" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="enable" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="c3_soft_reset" shortDescription="soft reset the c3 (reboot c3 daemon)">
        <CommandContainer name="c3_soft_reset_request">
          <EntryList>
            <FixedValueEntry binaryValue="01" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="c3_hard_reset" shortDescription="hard reset the c3 (reboot system)">
        <CommandContainer name="c3_hard_reset_request">
          <EntryList>
            <FixedValueEntry binaryValue="02" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="c3_factory_reset" shortDescription="factory reset the c3 (clear FRAM, reset RTC, and reboot system)">
        <CommandContainer name="c3_factory_reset_request">
          <EntryList>
            <FixedValueEntry binaryValue="03" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="co_node_enable" shortDescription="enable a CANopen node">
        <ArgumentList>
          <Argument name="node_id" argumentTypeRef="node_id_type" />
          <Argument name="enable" argumentTypeRef="bool_type" />
        </ArgumentList>
        <CommandContainer name="co_node_enable_request">
          <EntryList>
            <FixedValueEntry binaryValue="04" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="node_id" />
            <ArgumentRefEntry argumentRef="enable" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="co_node_status" shortDescription="get the status of a CANopen node">
        <ArgumentList>
          <Argument name="node_id" argumentTypeRef="node_id_type" />
        </ArgumentList>
        <CommandContainer name="co_node_status_request">
          <EntryList>
            <FixedValueEntry binaryValue="05" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="node_id" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="co_sdo_write" shortDescription="write a value to a node's OD over the CAN bus using a CANopen SDO message">
        <ArgumentList>
          <Argument name="node_id" argumentTypeRef="node_id_type" />
          <Argument name="index" argumentTypeRef="uint16_type" />
          <Argument name="subindex" argumentTypeRef="uint8_type" />
          <Argument name="buffer_size" argumentTypeRef="uint32_type" />
          <Argument name="buffer" argumentTypeRef="bytes_type" />
        </ArgumentList>
        <CommandContainer name="co_sdo_write_request">
          <EntryList>
            <FixedValueEntry binaryValue="06" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="node_id" />
            <ArgumentRefEntry argumentRef="index" />
            <ArgumentRefEntry argumentRef="subindex" />
            <ArgumentRefEntry argumentRef="buffer_size" />
            <ArgumentRefEntry argumentRef="buffer" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="co_sync" shortDescription="send a CANopen SYNC message on the CAN bus">
        <CommandContainer name="co_sync_request">
          <EntryList>
            <FixedValueEntry binaryValue="07" sizeInBits="8" />
          </EntryList>
        </CommandContainer>	- 	

      </MetaCommand>
      <MetaCommand name="opd_sysenable" shortDescription="enable the OPD subsystem">
        <ArgumentList>
          <Argument name="enable" argumentTypeRef="bool_type" />
        </ArgumentList>
        <CommandContainer name="opd_sysenable_request">
          <EntryList>
            <FixedValueEntry binaryValue="08" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="enable" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="opd_scan" shortDescription="scan for all nodes on the OPD">
        <CommandContainer name="opd_scan_request">
          <EntryList>
            <FixedValueEntry binaryValue="09" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="opd_probe" shortDescription="probe for a node on the OPD">
        <ArgumentList>
          <Argument name="opd_addr" argumentTypeRef="opd_addr_type" />
        </ArgumentList>
        <CommandContainer name="opd_probe_request">
          <EntryList>
            <FixedValueEntry binaryValue="0A" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="opd_addr" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="opd_enable" shortDescription="enable / disable a node on the OPD">
        <ArgumentList>
          <Argument name="opd_addr" argumentTypeRef="opd_addr_type" />
          <Argument name="enable" argumentTypeRef="bool_type" />
        </ArgumentList>
        <CommandContainer name="opd_enable_request">
          <EntryList>
            <FixedValueEntry binaryValue="0B" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="opd_addr" />
            <ArgumentRefEntry argumentRef="enable" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="opd_reset" shortDescription="reset a node on the OPD">
        <ArgumentList>
          <Argument name="opd_addr" argumentTypeRef="opd_addr_type" />
        </ArgumentList>
        <CommandContainer name="opd_reset_request">
          <EntryList>
            <FixedValueEntry binaryValue="0C" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="opd_addr" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="opd_status" shortDescription="get the status of a node on the OPD">
        <ArgumentList>
          <Argument name="opd_addr" argumentTypeRef="opd_addr_type" />
        </ArgumentList>
        <CommandContainer name="opd_status_request">
          <EntryList>
            <FixedValueEntry binaryValue="0D" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="opd_addr" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="rtc_set_time" shortDescription="set the RTC time">
        <ArgumentList>
          <Argument name="time" argumentTypeRef="uint32_type" />
        </ArgumentList>
        <CommandContainer name="rtc_set_time_request">
          <EntryList>
            <FixedValueEntry binaryValue="0E" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="time" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="time_sync" shortDescription="c3 will send OreSat's time sync TPDO over the CAN bus (all nodes that are powered on and care about time will sync to it)">
        <CommandContainer name="time_sync_request">
          <EntryList>
            <FixedValueEntry binaryValue="0F" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="beacon_ping" shortDescription="c3 will response with a beacon regardless of tx state">
        <CommandContainer name="beacon_ping_request">
          <EntryList>
            <FixedValueEntry binaryValue="10" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="ping" shortDescription="a basic ping to the c3">
        <ArgumentList>
          <Argument name="value" argumentTypeRef="uint32_type" />
        </ArgumentList>
        <CommandContainer name="ping_request">
          <EntryList>
            <FixedValueEntry binaryValue="11" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="value" />
            <!-- <FixedValueEntry name="uslp_fecf" binaryValue="0000" sizeInBits="16" /> -->
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="rx_test" shortDescription="empty command for c3 Rx testing">
        <CommandContainer name="rx_test_request">
          <EntryList>
            <FixedValueEntry binaryValue="12" sizeInBits="8" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="co_sdo_read" shortDescription="read a value from a node's OD over the CAN bus using a CANopen SDO message">
        <ArgumentList>
          <Argument name="node_id" argumentTypeRef="node_id_type" />
          <Argument name="index" argumentTypeRef="uint16_type" />
          <Argument name="subindex" argumentTypeRef="uint8_type" />
        </ArgumentList>
        <CommandContainer name="co_sdo_read_request">
          <EntryList>
            <FixedValueEntry binaryValue="13" sizeInBits="8" />
            <ArgumentRefEntry argumentRef="node_id" />
            <ArgumentRefEntry argumentRef="index" />
            <ArgumentRefEntry argumentRef="subindex" />
          </EntryList>
        </CommandContainer>
      </MetaCommand>
